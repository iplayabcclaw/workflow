# Do not commit .env. These values remain on the server and are never sent to the browser.
AUTODL_TOKEN=replace-with-your-token
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-your-password
MYSQL_DATABASE=minimax_h3_workflow
PORT=3000
POLL_INTERVAL_MS=60000
# GPT-Image2 / GRSAI（也兼容 GRASI_IMAGE_* 命名）
GRSAI_IMAGE_API_KEY=replace-with-your-grsai-key
GRSAI_IMAGE_ENDPOINT=https://grsai.dakka.com.cn/v1/draw/completions
GRSAI_IMAGE_RESULT_ENDPOINT=https://grsai.dakka.com.cn/v1/draw/result
# 腾讯云 COS：参考图片、参考音频均先上传到这里，再把公网 URL 发送给生图/生视频接口。
COS_REGION=ap-beijing
COS_BUCKET=your-bucket-appid
COS_SECRET_ID=replace-with-your-secret-id
COS_SECRET_KEY=replace-with-your-secret-key
COS_URL=https://cdn.example.com
COS_UPLOAD_PREFIX=h3-workflow
# Use a long random value in production, for example: openssl rand -hex 32
AUTH_SECRET=replace-with-a-long-random-secret
# Created once automatically when the service starts. Change the password after first login.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-at-least-8-characters
AUTH_TOKEN_TTL_SECONDS=604800
